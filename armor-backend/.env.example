# ─── MQTT Broker (Eclipse Mosquitto) ────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883

# ─── SQLite Database ──────────────────────────────────────────────────
ARMOR_DB=data/armor.db

# ─── Vision AI Engine ─────────────────────────────────────────────────
# When model is delivered by SW Member 1, place weights file in models/ and uncomment:
# YOLO_MODEL_PATH=models/yolov8_helmet.pt
# Leave blank to use internal OpenCV fallback/stub engine
YOLO_MODEL_PATH=
CAMERA_INDEX=0
COMPLIANCE_THRESHOLD=0.65

# ─── Telegram Alert Bot ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Server Configuration ─────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
