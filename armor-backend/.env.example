# --- MQTT Broker (Eclipse Mosquitto) ---
MQTT_BROKER=localhost
MQTT_PORT=1883

# --- SQLite Database ---
ARMOR_DB=data/armor.db

# --- Vision AI Engine ---
# Optional YOLOv8-seg weights (ultralytics). Leave blank to use the built-in stub.
YOLO_MODEL_PATH=
# Camera source: integer index (0) or a video file path
CAMERA_SOURCE=0
# Helmet compliance threshold (mask overlap ratio)
HELMET_COMPLIANCE_THRESHOLD=0.65
# Snapshot output directory
SNAPSHOT_DIR=data/snapshots

# --- Roboflow Workflow (planned: RF-DETR + SAM 3 helmet check) ---
# Leave blank to keep the built-in stub/YOLO path.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=ashwin-mathur
ROBOFLOW_WORKFLOW_ID=helmet-check-hackathon-demo-1793134805931

# --- Face Recognition (stretch, off by default) ---
FACE_RECOGNITION_ENABLED=false
KNOWN_FACES_DIR=data/known_faces

# --- Telegram Alert Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard (Streamlit) ---
ARMOR_API_URL=http://127.0.0.1:8000
ARMOR_DEVICE_ID=machino_node_01

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
