# --- MQTT Broker (Eclipse Mosquitto) ---
MQTT_BROKER=localhost
MQTT_PORT=1883

# --- SQLite Database ---
ARMOR_DB=data/armor.db

# --- Vision AI Engine ---
# Optional YOLOv8-seg weights (ultralytics). Leave blank to use the built-in stub.
YOLO_MODEL_PATH=
# Camera source: integer index (0) or a video file path
CAMERA_SOURCE=0
# Helmet compliance threshold (mask overlap ratio)
HELMET_COMPLIANCE_THRESHOLD=0.65
# Snapshot output directory
SNAPSHOT_DIR=data/snapshots

# --- Telegram Alert Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
